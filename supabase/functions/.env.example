# Edge Function secrets — supabase/functions
#
# Every name below is read by `Deno.env.get` somewhere under this directory.
# Regenerate the list with:
#
#   grep -rhoE "Deno\.env\.get\(\s*['\"][A-Za-z0-9_]+['\"]" supabase/functions \
#     | sed -E "s/.*['\"]([A-Za-z0-9_]+)['\"]/\1/" | sort -u
#
# (plus SITE_URL, FUNCTIONS_URL and PAGESPEED_API_KEY, which are read through
# _shared/env.ts and so do not appear as string literals).
#
# Set them with `supabase secrets set NAME=value`. Nothing here is a value —
# only the names and what each one is for.
#
# Names deliberately NOT in this file, because nothing reads them any more
# (US-123): APP_URL, FRONTEND_URL and PUBLIC_SITE_URL (all now SITE_URL),
# EDGE_FUNCTIONS_URL (now FUNCTIONS_URL), PAGESPEED_INSIGHTS_API_KEY (now
# PAGESPEED_API_KEY), ENCRYPTION_MASTER_KEY and AGENT_EMAIL (their only
# readers, the encrypt-pii function and createAgentNotificationEmail, are
# deleted).

# --- Supabase runtime -------------------------------------------------------
# Injected automatically by the Supabase platform; set them only when running
# the functions outside it.
SUPABASE_URL=                     # Base URL of the Supabase project (105 uses)
SUPABASE_SERVICE_ROLE_KEY=        # Service-role key: bypasses RLS, never send to a browser
SUPABASE_ANON_KEY=                # Anon key, for calls that should run as the end user

# --- Deployment identity ----------------------------------------------------
SITE_URL=                         # Public origin of the web app; every emailed and redirect link is built from it. Default https://agentbio.net
FUNCTIONS_URL=                    # Origin serving these functions, for function-to-function HTTP calls. Default https://functions.agentbio.net
ENVIRONMENT=                      # 'development' adds localhost to the CORS whitelist
DENO_ENV=                         # 'test' suppresses outbound email in _shared/email.ts

# --- Email ------------------------------------------------------------------
RESEND_API_KEY=                   # Resend API key; unset means sendEmail reports a failure rather than silently dropping
FROM_EMAIL=                       # Envelope From for outbound mail. Default noreply@agentbio.net

# --- Encryption at rest -----------------------------------------------------
PII_ENCRYPTION_KEY=               # Master secret for _shared/encryption.ts (AES-256-GCM, PBKDF2, enc:v1 envelope). Min 16 chars
ENCRYPTION_KEY=                   # Deprecated alias for PII_ENCRYPTION_KEY, still read as a fallback so an existing deployment keeps decrypting. Set PII_ENCRYPTION_KEY on new ones

# --- Billing ----------------------------------------------------------------
STRIPE_SECRET_KEY=                # Stripe API key for checkout, portal and subscription sync
STRIPE_WEBHOOK_SECRET=            # Signing secret used to verify the Stripe webhook payload

# --- OAuth (sign-in via oauth-proxy) ---------------------------------------
GOOGLE_CLIENT_ID=                 # Google sign-in client id
GOOGLE_CLIENT_SECRET=             # Google sign-in client secret
MICROSOFT_CLIENT_ID=              # Microsoft sign-in client id
MICROSOFT_CLIENT_SECRET=          # Microsoft sign-in client secret
APPLE_CLIENT_ID=                  # Apple sign-in service id
APPLE_CLIENT_SECRET=              # Apple sign-in client secret (the signed JWT)
YANDEX_CLIENT_ID=                 # Yandex sign-in client id
YANDEX_CLIENT_SECRET=             # Yandex sign-in client secret

# --- Search-console and analytics integrations ------------------------------
GOOGLE_REDIRECT_URI=              # Callback for the Search Console OAuth grant (gsc-oauth)
GOOGLE_ANALYTICS_REDIRECT_URI=    # Callback for the GA4 OAuth grant
BING_WEBMASTER_REDIRECT_URI=      # Callback for the Bing Webmaster OAuth grant
YANDEX_WEBMASTER_REDIRECT_URI=    # Callback for the Yandex Webmaster OAuth grant
GOOGLE_SERVICE_ACCOUNT_JSON=      # Service-account credentials for the Indexing API (google-indexing)
PAGESPEED_API_KEY=                # Google API key for PageSpeed Insights, and for CrUX unless CHROME_UX_API_KEY is set
CHROME_UX_API_KEY=                # Separate key for the Chrome UX Report API, if it differs from the PageSpeed one

# --- AI providers -----------------------------------------------------------
CLAUDE_API_KEY=                   # Anthropic key: article generation and social posts
OPENAI_API_KEY=                   # OpenAI key: listing descriptions and SEO autofix
LOVABLE_API_KEY=                  # Lovable AI gateway key: blog content and title management
AI_MODEL=                         # Overrides the default model id used by apply-seo-autofix

# --- Rate limiting ----------------------------------------------------------
UPSTASH_REDIS_REST_URL=           # Upstash Redis REST endpoint; unset falls back to the Postgres counter
UPSTASH_REDIS_REST_TOKEN=         # Upstash Redis REST token

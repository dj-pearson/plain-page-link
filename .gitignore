# Test artifacts.
#
# US-121: exportUtils.test.ts drove jsPDF's doc.save() under jsdom, which takes
# the Node path and wrote lead_report_<date>.pdf and performance_<date>.pdf into
# this directory on every `npm run test:run`. Four of them had been committed.
# The test stubs save() now, so nothing should land here — this is the backstop.
*.pdf
test-reports/
test-results/
playwright-report/
playwright-report-e2e/
playwright-report-a11y/

# Database dumps and backups. db-backup/ was 9.9 MB of cluster backups and
# article rows in git, with .gitignore covering 2 of its 14 files.
db-backup/
*.backup
*.backup.*
*.dump
*.sql.gz

# Local scratch
*.local

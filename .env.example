# =============================================================================
# Self-Hosted Supabase Configuration
# =============================================================================
# For self-hosted Supabase, configure separate subdomains for each service:
#
# API Subdomain (Kong API Gateway) - REST API, Auth, Storage, Realtime
# - This is your main Supabase URL for database operations
VITE_SUPABASE_URL=https://api.agentbio.net

# Supabase Anonymous Key
# - Get this from your self-hosted Supabase dashboard or docker-compose
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Edge Functions Subdomain
# - For self-hosted: typically runs on a separate functions subdomain
# - This is where your Deno edge functions are deployed
VITE_FUNCTIONS_URL=https://functions.agentbio.net

# =============================================================================
# Firebase Configuration (Optional - Required only if using push notifications)
# =============================================================================
# Get these from Firebase Console: https://console.firebase.google.com/
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# =============================================================================
# App Configuration
# =============================================================================
VITE_APP_URL=https://agentbio.net

# =============================================================================
# PII Encryption — server-side only
# =============================================================================
# Master key used to derive the AES-256-GCM key for PII at rest: leads
# encrypted_email / encrypted_phone, profiles phone, and highly sensitive
# secrets such as TOTP/MFA seeds.
#
# There is deliberately NO VITE_ variant. There used to be
# VITE_PII_ENCRYPTION_KEY, and it was a hole: Vite inlines every VITE_-prefixed
# value into the production bundle, so the key protecting the ciphertext was
# downloadable by anyone who loaded the site. Removed in US-066 — the browser
# now calls the `pii-crypto` Edge Function, which holds this secret. If you find
# yourself adding VITE_PII_ENCRYPTION_KEY back, you are re-opening that hole.
#
# This is an Edge Function secret, not a build-time var:
#   supabase secrets set PII_ENCRYPTION_KEY="$(openssl rand -base64 48)"
#
# Keep it stable: rotating it makes every existing `enc:v1:` value
# undecryptable, so plan a re-encryption backfill first. Used by
# supabase/functions/_shared/encryption.ts and supabase/functions/pii-crypto/.
PII_ENCRYPTION_KEY=change-me-to-a-long-random-server-secret

# =============================================================================
# Email / Transactional Email (Resend) — Edge Function secrets
# =============================================================================
# Used by supabase/functions/_shared/email.ts for welcome emails, lead
# notifications, and other transactional mail. Set these as Edge Function
# secrets (Supabase Dashboard → Settings → Edge Functions → Secrets), e.g.:
#   supabase secrets set RESEND_API_KEY=re_xxx FROM_EMAIL=noreply@agentbio.net
#
# - RESEND_API_KEY: Resend API key from https://resend.com/api-keys.
#   If unset, sendEmail() logs a warning and no-ops (never crashes).
# - FROM_EMAIL: verified sender address (default noreply@agentbio.net).
# - AGENT_EMAIL: fallback recipient for generic agent notifications.
# - SITE_URL: base URL used to build links in emails (default https://agentbio.net).
# RESEND_API_KEY=re_your_api_key_here
# FROM_EMAIL=noreply@agentbio.net
# AGENT_EMAIL=agent@example.com
# SITE_URL=https://agentbio.net

# =============================================================================
# Stripe Configuration (Required for payments)
# =============================================================================
# Get these from your Stripe Dashboard: https://dashboard.stripe.com/
#
# IMPORTANT: These variables must be set in Supabase Edge Function secrets:
# - STRIPE_SECRET_KEY: Your Stripe secret key (sk_live_... or sk_test_...)
# - STRIPE_WEBHOOK_SECRET: Webhook signing secret (whsec_...)
#
# Set these in Supabase Dashboard → Settings → Edge Functions → Secrets
#
# Frontend Stripe Configuration (for future Stripe.js integration)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# =============================================================================
# Stripe Price IDs (Set in Supabase Edge Function secrets for production)
# =============================================================================
# These map your Stripe product prices to plan names.
# Create products in Stripe Dashboard and copy the price IDs here.
#
# Monthly Plans:
# STRIPE_PRICE_STARTER_MONTHLY=price_xxxxx
# STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_xxxxx
# STRIPE_PRICE_TEAM_MONTHLY=price_xxxxx
# STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxxxx
#
# Yearly Plans:
# STRIPE_PRICE_STARTER_YEARLY=price_xxxxx
# STRIPE_PRICE_PROFESSIONAL_YEARLY=price_xxxxx
# STRIPE_PRICE_TEAM_YEARLY=price_xxxxx
# STRIPE_PRICE_ENTERPRISE_YEARLY=price_xxxxx

# =============================================================================
# Sentry Error Monitoring (Required for production error tracking)
# =============================================================================
# Get your DSN from Sentry dashboard: https://sentry.io/
# Navigate to: Settings > Projects > [Your Project] > Client Keys (DSN)
VITE_SENTRY_DSN=

# Optional: Override to enable Sentry in development
# VITE_SENTRY_ENABLED=true

# Optional: Version tag for release tracking
# VITE_APP_VERSION=1.0.0

# =============================================================================
# Google Analytics (Optional)
# =============================================================================
# Already configured in index.html, but you can override here if needed

# =============================================================================
# Google Indexing API (Set in Supabase Edge Function secrets)
# =============================================================================
# Service account JSON for Google Indexing API v3
# See: https://developers.google.com/search/apis/indexing-api/v3/prereqs
# 1. Create a service account in Google Cloud Console
# 2. Enable the Indexing API for your project
# 3. Add the service account email as an owner in Google Search Console
# 4. Export the service account JSON key and set it as a secret:
#    GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...",...}

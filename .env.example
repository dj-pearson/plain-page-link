# =============================================================================
# AgentBio — frontend environment
# =============================================================================
#
# Every key below is read by src/. Nothing else is, and nothing read by src/ is
# missing — US-123 regenerated this file from a grep of `import.meta.env.VITE_*`
# after it had drifted into documenting seven VITE_FIREBASE_* keys for push
# notifications that US-059 removed, a VITE_STRIPE_PUBLISHABLE_KEY the app never
# reads, and PII_ENCRYPTION_KEY — a SERVER secret that must never be in a
# frontend template, because Vite inlines every VITE_-prefixed value into the
# production bundle and a reader could reasonably assume the same file's
# non-prefixed keys belong in the same place.
#
# Server secrets live in supabase/functions/.env.example.
#
# Copy to .env.local for development. Only VITE_SUPABASE_URL and
# VITE_SUPABASE_ANON_KEY are required — src/integrations/supabase/client.ts
# throws at import without them.

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Self-hosted Supabase API gateway (Kong): REST, Auth, Storage, Realtime.
VITE_SUPABASE_URL=https://api.agentbio.net

# The anon key. Public by design — it ships in the bundle — so everything it can
# reach must be safe for a stranger. See the RLS notes in CLAUDE.md.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# Where the edge functions are served. Self-hosted Supabase puts them on their
# own subdomain; without this the client falls back to VITE_SUPABASE_URL.
VITE_FUNCTIONS_URL=https://functions.agentbio.net

# This app's own public origin, used to build shareable URLs. Defaults to
# window.location.origin, so it is only needed where that is wrong (SSR, a
# preview deployment that should still print production links).
VITE_APP_URL=https://agentbio.net

# An explicit REST origin, if it differs from VITE_SUPABASE_URL (src/lib/constants.ts).
VITE_API_URL=

# Google Analytics 4 measurement id. public/scripts/analytics.js reads this at
# runtime; with no value, no analytics script is loaded at all.
VITE_GA_MEASUREMENT_ID=

# Sentry. VITE_SENTRY_DSN turns error reporting on in production;
# VITE_SENTRY_ENABLED=true also turns it on outside production.
VITE_SENTRY_DSN=
VITE_SENTRY_ENABLED=false

# Reported alongside Sentry events: the release, and where it is deployed.
VITE_APP_VERSION=1.0.0
VITE_DEPLOYMENT_REGION=

# Force the logger on outside development (src/lib/logger.ts). The logger
# redacts credentials either way, but production logging is off by default.
VITE_ENABLE_LOGGING=false

# OAuth client ids for the search-console integrations on the ADMIN pages
# (src/hooks/useSearchAnalytics.ts). Not needed to run the product.
VITE_GOOGLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
VITE_YANDEX_CLIENT_ID=
